# GEMINI_API_KEY: Optional - used for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GAS_URL: Google Apps Script Web App URL (Live Database & Email Backend)
# Put this in Vercel -> Project Settings -> Environment Variables
# Key: VITE_GAS_URL
# Value: https://script.google.com/macros/s/AKfycb.../exec
VITE_GAS_URL=""
